{
  "version": "0.4.0",
  "plugin": "content-media",
  "types": [
    {
      "type": "Article",
      "folder": "articles",
      "description": "Published or publishable piece"
    },
    {
      "type": "Draft",
      "folder": "drafts",
      "description": "Work in progress"
    },
    {
      "type": "Series",
      "folder": "series",
      "description": "Named sequence of articles"
    },
    {
      "type": "EditorialCalendar",
      "folder": "editorial-calendars",
      "description": "Planned publish dates"
    },
    {
      "type": "Headline",
      "folder": "headlines",
      "description": "Title variant"
    },
    {
      "type": "Hook",
      "folder": "hooks",
      "description": "Opening hook"
    },
    {
      "type": "Outline",
      "folder": "outlines",
      "description": "Structure of a piece"
    },
    {
      "type": "KeyPoint",
      "folder": "key-points",
      "description": "Claim the piece must land"
    },
    {
      "type": "CallToAction",
      "folder": "call-to-actions",
      "description": "What the reader should do"
    },
    {
      "type": "Subscriber",
      "folder": "subscribers",
      "description": "Audience member or segment proxy"
    },
    {
      "type": "Segment",
      "folder": "segments",
      "description": "Audience cohort"
    },
    {
      "type": "AudienceInsight",
      "folder": "audience-insights",
      "description": "What the audience cares about"
    },
    {
      "type": "PerformanceMetric",
      "folder": "articles",
      "description": "Views, reads, restacks, etc."
    },
    {
      "type": "DistributionChannel",
      "folder": "distribution-channels",
      "description": "Medium, Substack, LinkedIn, etc."
    },
    {
      "type": "PromotionPlan",
      "folder": "promotion-plans",
      "description": "How a piece will be pushed"
    },
    {
      "type": "RepurposingNote",
      "folder": "repurposing-notes",
      "description": "How to slice the piece"
    },
    {
      "type": "StyleGuide",
      "folder": "style-guides",
      "description": "Voice and format rules"
    },
    {
      "type": "PositioningStatement",
      "folder": "positioning-statements",
      "description": "How we talk about the offer"
    },
    {
      "type": "ContentExperiment",
      "folder": "content-experiments",
      "description": "A/B or format test"
    },
    {
      "type": "Feedback",
      "folder": "feedbacks",
      "description": "Reader or editor feedback"
    }
  ],
  "rels": [
    {
      "rel": "authored_by",
      "description": "Writer identity"
    },
    {
      "rel": "belongs_to",
      "description": "Article in a series"
    },
    {
      "rel": "promotes",
      "description": "Article promotes an offer or idea"
    },
    {
      "rel": "engaged_with",
      "description": "Subscriber engaged with article"
    },
    {
      "rel": "distributed_on",
      "description": "Channel"
    },
    {
      "rel": "measured_by",
      "description": "Has performance metrics"
    },
    {
      "rel": "originates_from",
      "description": "Came from experiment or outline"
    },
    {
      "rel": "related_to",
      "description": "Related pieces"
    },
    {
      "rel": "supersedes",
      "description": "Updated version"
    },
    {
      "rel": "draws_from",
      "from": "Article",
      "to": "Finding",
      "owner": "content-media",
      "description": "Canonical stored edge to an RKC Finding. Never persist informs."
    }
  ],
  "query_only_rels": [
    {
      "rel": "informs",
      "from": "Finding",
      "to": "Article",
      "description": "Query-only inverse of draws_from. Derived by research-graph. Never persist."
    }
  ]
}
